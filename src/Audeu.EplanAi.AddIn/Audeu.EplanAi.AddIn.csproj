<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Audeu.EplanAi.AddIn</AssemblyName>
    <RootNamespace>Audeu.EplanAi.AddIn</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Audeu.EplanAi.Contracts\Audeu.EplanAi.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EplanRequiredAssembly Include="$(EplanApi29Dir)\Eplan.EplApi.AFu.dll" />
    <EplanRequiredAssembly Include="$(EplanApi29Dir)\Eplan.EplApi.Baseu.dll" />
    <EplanRequiredAssembly Include="$(EplanApi29Dir)\Eplan.EplApi.DataModelu.dll" />
    <EplanRequiredAssembly Include="$(EplanApi29Dir)\Eplan.EplApi.HEServicesu.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(EplanApi29Dir)' != ''">
    <Reference Include="Eplan.EplApi.AFu" HintPath="$(EplanApi29Dir)\Eplan.EplApi.AFu.dll" Private="false" />
    <Reference Include="Eplan.EplApi.Baseu" HintPath="$(EplanApi29Dir)\Eplan.EplApi.Baseu.dll" Private="false" />
    <Reference Include="Eplan.EplApi.DataModelu" HintPath="$(EplanApi29Dir)\Eplan.EplApi.DataModelu.dll" Private="false" />
    <Reference Include="Eplan.EplApi.HEServicesu" HintPath="$(EplanApi29Dir)\Eplan.EplApi.HEServicesu.dll" Private="false" />
  </ItemGroup>
</Project>
